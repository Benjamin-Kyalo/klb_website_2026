# Frontend build options. Copy to .env or .env.production only when overriding.
# Vite embeds these values at build time, so rebuild after changing them.

# API base path. Keep /api when Django serves the built app on the same domain.
VITE_API_BASE=/api

# Absolute public site URL used in canonical links, Open Graph tags and JSON-LD.
# Replace with the real domain before a production build.
VITE_SITE_URL=https://klb.example
