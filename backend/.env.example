# ---------------------------------------------------------------------------
# KLB website - backend environment variables
# Copy this file to .env and edit the values. Never commit the real .env.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# PostgreSQL
# Create this user and database once before running the setup (see docs/SETUP.md).
# The default local PostgreSQL server listens on port 5432.
DATABASE_URL=postgres://klb:klb_dev_password@127.0.0.1:5432/klb
# Use your own local password if you created the user with a different one:
# DATABASE_URL=postgres://klb:your_password@127.0.0.1:5432/klb
# Production example (use a strong password and sslmode=require if supported):
# DATABASE_URL=postgres://klb_user:strong_password@db-host:5432/klb_prod?sslmode=require

# Website administrator created by `python manage.py seed_content`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=KLB Administrator

# Security switches - set these to True behind HTTPS in production
DJANGO_SECURE_SSL=False
DJANGO_SECURE_COOKIES=False
